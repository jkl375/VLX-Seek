FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/mindie:3.1.0-cann9.0.1-torch_npu2.9.0.post4-910b-openeuler24.03_lts-py3.11

RUN pip install timm --no-cache-dir --constraint <(echo "torch==2.9.0")

RUN pip install triton-ascend==3.2.2 --extra-index-url=https://triton-ascend.osinfra.cn/pypi/simple

RUN pip install flash-linear-attention[npu] --constraint <(echo "torch==2.9.0")

COPY docker/requirements_npu.txt docker/requirements_npu.txt

RUN pip install -r docker/requirements_npu.txt -i https://pypi.tuna.tsinghua.edu.cn/simple